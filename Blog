.mc-hijos{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;width:100%}
.mc small{display:block;color:var(--suave);font-weight:400;font-size:.78rem}
.etiqueta{font-size:.8rem;color:var(--suave);font-style:italic}
/* cuadro sinóptico */
.sin{min-width:640px;display:grid;grid-template-columns:auto auto 1fr;align-items:center;gap:0}
.llave{font-family:'Fraunces',serif;font-size:7rem;line-height:.9;color:var(--lila2);font-weight:300;padding:0 .4rem}
.sin-grupo{display:flex;flex-direction:column;gap:1rem;grid-column:3}
.sin-fila{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:.6rem}
.sin-fila .llave{font-size:4.6rem}
.sin-det{font-size:.88rem;text-align:left;font-weight:400}
.sin-det b{font-weight:700}
.sin-tit{grid-column:1/4;margin-bottom:.6rem}
.sin-fam{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:.4rem;margin-bottom:1rem}
.sin-fam>.nodo{min-width:150px}
/* mapa mental */
.mm{min-width:640px;display:grid;grid-template-columns:1fr auto 1fr;grid-template-rows:auto auto auto;gap:1rem 0;align-items:center}
.rama{display:flex;align-items:center;gap:.5rem}
.rama.der{flex-direction:row-reverse}
.rama .hojas{font-size:.85rem;background:#fff;border-radius:12px;padding:.5rem .8rem;box-shadow:var(--sombra);max-width:230px}
.rama .linea{height:3px;width:34px;background:var(--lila2);border-radius:3px;flex:none}
.mm .centro{grid-row:1/4;grid-column:2;padding:1.4rem 1rem;max-width:200px;border-radius:50%;aspect-ratio:1;display:flex;align-items:center;justify-content:center}
/* cuadro comparativo */
.tabla{overflow-x:auto;border-radius:var(--r);box-shadow:var(--sombra)}
table{border-collapse:collapse;width:100%;min-width:640px;background:#fff}
th,td{padding:.8rem 1rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--azul);font-size:.95rem}
