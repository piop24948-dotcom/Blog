/* ===== VARIABLES Y BASE ===== */
:root{--bg:#fffdf9;--beige:#f5ede0;--azul:#dbe9f8;--azul2:#a9c8ec;--lila:#e6dcf5;--lila2:#b9a4de;--tinta:#2d3350;--suave:#5b6283;--sombra:0 6px 20px rgba(80,90,140,.12);--r:18px}
