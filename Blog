const li = a => a.map(x=>'<li>'+x+'</li>').join('');
function render(p){
 return `<article class="card post" id="${p.id}">
  <header><span class="ico" aria-hidden="true">${p.ico}</span><div><h3>${p.t}</h3><span class="meta">Por <span class="nombre-autor">[Oscar Alejandro García García]</span></span></div></header>
  <img class="foto-post" src="${p.img}" alt="${p.alt}" loading="lazy" onerror="this.removeAttribute('src')">
  <div><h4>Definición</h4><p>${p.def}</p></div>
  <div class="cols">
    <div><h4>Características principales</h4><ul>${li(p.car)}</ul></div>
    <div><h4>Funciones y utilidad</h4><ul>${li(p.fun)}</ul></div>
    <div><h4>Ejemplos de plataformas</h4><div class="plat">${p.pl.map(x=>'<span>'+x+'</span>').join('')}</div></div>
  </div>
  <div class="card practico"><h4>Ejemplo práctico</h4><p>${p.pra}</p></div>
  <div class="cols">
    <div class="card pro"><h4>✅ Ventajas</h4><ul>${li(p.pro)}</ul></div>
    <div class="card con"><h4>⚠️ Desventajas</h4><ul>${li(p.con)}</ul></div>
  </div></article>`;
}
document.getElementById('posts-com').innerHTML = posts.filter(p=>p.g==='com').map(render).join('');
document.getElementById('posts-soc').innerHTML = posts.filter(p=>p.g==='soc').map(render).join('');

/* ===== CUADRO SINÓPTICO (generado con los mismos datos) ===== */
const resumen = {
 correo:'Mensajes escritos con adjuntos · formal y asíncrono',
 mensajeria:'Chat inmediato en grupos o individual · rápido',
 videollamadas:'Audio y video en tiempo real · sincrónica',
 redes:'Perfiles, contenido e interacción · gran alcance',
 blogs:'Entradas ordenadas por fecha · informar y opinar',
 paginas:'Sitio de presentación y portafolio · contenido estable'};
const fam = (titulo,cls,ids)=>`<div class="sin-fam"><div class="nodo ${cls}">${titulo}</div><div style="display:grid;grid-template-columns:auto 1fr;align-items:center"><span class="llave" style="font-size:6rem">{</span><div style="display:flex;flex-direction:column;gap:.5rem">${ids.map(i=>{const p=posts.find(x=>x.id===i);return `<div class="sin-fila"><div class="nodo">${p.ico} ${p.t}</div><div class="sin-det"><b>Def.:</b> ${resumen[i]}.<br><b>Ejemplos:</b> ${p.pl.join(', ')}</div></div>`}).join('')}</div></div></div>`;
document.getElementById('sinoptico').innerHTML = `<div class="sin-tit" style="grid-column:1/4"><div class="nodo n-centro" style="display:inline-block">Herramientas digitales</div></div><div style="grid-column:1/4">${fam('Herramientas de comunicación','n-a',['correo','mensajeria','videollamadas'])}${fam('Herramientas de socialización','n-b',['redes','blogs','paginas'])}</div>`;

/* ===== NOMBRE DEL AUTOR: sincroniza portada, posts y pie de página ===== */
const campo = document.querySelector('.nombre-autor-edit');
campo.addEventListener('input',()=>{const v=campo.textContent.trim()||'[Nombre del estudiante]';document.querySelectorAll('.nombre-autor').forEach(e=>e.textContent=v)});

/* ===== FOTOGRAFÍA DEL ESTUDIANTE ===== */
const foto=document.getElementById('foto'),arch=document.getElementById('archivo');
foto.addEventListener('click',()=>arch.click());
foto.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();arch.click()}});
arch.addEventListener('change',()=>{const f=arch.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{foto.innerHTML='<img alt="Fotografía del estudiante" src="'+r.result+'">'};r.readAsDataURL(f)});

/* ===== MENÚ MÓVIL, ENLACE ACTIVO Y BOTÓN DE REGRESO ===== */
const menu=document.getElementById('menu'),burger=document.getElementById('burger');
burger.addEventListener('click',()=>{const a=menu.classList.toggle('abierto');burger.setAttribute('aria-expanded',a)});
menu.addEventListener('click',e=>{if(e.target.tagName==='A'){menu.classList.remove('abierto');burger.setAttribute('aria-expanded',false)}});
const enlaces=[...menu.querySelectorAll('a')];
const obs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){enlaces.forEach(a=>a.classList.toggle('activo',a.getAttribute('href')==='#'+e.target.id))}}),{rootMargin:'-40% 0px -55% 0px'});
document.querySelectorAll('header#inicio, main > section').forEach(s=>obs.observe(s));
const arriba=document.getElementById('arriba');
window.addEventListener('scroll',()=>arriba.classList.toggle('ver',scrollY>500));
arriba.addEventListener('click',()=>scrollTo({top:0,behavior:'smooth'}));
</script>
